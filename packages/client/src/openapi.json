  "info": {
    "description": "Read-only research API. No order-execution surface exists in v1 (PD-1). Errors use the envelope {error:{code,message,detail}}.",
    "title": "CryptoOS API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/config/defaults": {
      "get": {
        "description": "Documented defaults (PD-11): the file the API resolves parameters against.",
        "operationId": "config_defaults_v1_config_defaults_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DefaultsResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Config Defaults",
        "tags": [
          "system"
        ]
      }
    },
    "/v1/data/gaps": {
      "get": {
        "description": "Every stored exclusion interval (section 4.6: reports list all of them).",
        "operationId": "data_gaps_v1_data_gaps_get",
        "parameters": [
          {
            "in": "query",
            "name": "instrument_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Instrument Id"
            }
          },
          {
            "in": "query",
            "name": "timeframe",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Timeframe"
            }
          },
          {
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/GapView"
                  },
                  "title": "Response Data Gaps V1 Data Gaps Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Data Gaps",
        "tags": [
          "data",
          "data"
        ]
      }
    },
