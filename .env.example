# --- CryptoOS environment template (PD-8: real values live only in .env) ---
# Copy to .env and fill in. .env is gitignored.

# PostgreSQL (spec §3.1 defaults to localhost:5432; this machine runs the CryptoOS
# cluster on 5433 — see docs/DECISIONS.md D-002)
DATABASE_URL=postgresql+psycopg://cryptoos:<password>@localhost:5433/cryptoos

# API
API_HOST=127.0.0.1
API_PORT=8000

# Web
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000

# Browser origins allowed to call the API cross-origin (web runs on 3000, API
# on 8000, so they are different origins). Comma-separated; recorded in
# docs/DECISIONS.md.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Data-layer parameters (OD-5 storage budget) live in config/defaults.yaml (PD-11),
# not here: only the request or that file may supply parameter defaults.
